import cv2
import math
import random
import time
import numpy as np

# Module-level state for persistent fireball particle FX
_fireball_embers = []      # [x, y, vx, vy, size, life, max_life, color]
_fireball_shockwaves = []  # [x, y, radius, max_radius, life, max_life, color]
_fireball_flashes = []     # [x, y, radius, life, max_life]

MAX_EMBERS = 90


def _draw_roi_glow(frame, center, radius, color, alpha):
    """
    Fast sub-image ROI alpha blending for glow circles.
    Avoids copying the full frame buffer.
    """
    if alpha <= 0 or radius <= 0:
        return
    x, y = int(center[0]), int(center[1])
    r = int(radius)
    h, w = frame.shape[:2]

    x1 = max(0, x - r)
    x2 = min(w, x + r)
    y1 = max(0, y - r)
    y2 = min(h, y + r)

    if x1 >= x2 or y1 >= y2:
        return

    roi = frame[y1:y2, x1:x2]
    overlay = roi.copy()
    lx = x - x1
    ly = y - y1

    cv2.circle(overlay, (lx, ly), r, color, -1, cv2.LINE_AA)
    cv2.addWeighted(overlay, min(1.0, alpha), roi, 1.0 - min(1.0, alpha), 0, roi)


def trigger_fireball_launch(center, velocity=(0, -18.0)):
    """
    Triggers a high-velocity explosive launch burst at the given center location.
    Includes a bright launch flash, an expanding shockwave ring, and a burst of directional embers.
    """
    global _fireball_embers, _fireball_shockwaves, _fireball_flashes

    cx, cy = int(center[0]), int(center[1])
    vx, vy = velocity

    # Bright launch flash
    _fireball_flashes.append([cx, cy, 60, 6, 6])

    # Expanding shockwave ring
    _fireball_shockwaves.append([cx, cy, 10, 85, 14, 14, (0, 180, 255)])

    # Explosive directional ember burst
    for _ in range(24):
        angle = random.uniform(0, 2 * math.pi)
        speed = random.uniform(4.0, 12.0)
        evx = math.cos(angle) * speed + vx * 0.35
        evy = math.sin(angle) * speed + vy * 0.35
        life = random.randint(14, 28)
        size = random.randint(3, 6)
        color = (0, random.randint(140, 255), 255)
        _fireball_embers.append([float(cx), float(cy), evx, evy, size, life, life, color])

    # Enforce maximum particle count
    if len(_fireball_embers) > MAX_EMBERS:
        _fireball_embers = _fireball_embers[-MAX_EMBERS:]


def trigger_fireball_impact(center):
    """
    Triggers an explosive fireball impact burst at the given center location.
    """
    global _fireball_embers, _fireball_shockwaves, _fireball_flashes

    cx, cy = int(center[0]), int(center[1])

    # Impact shockwave flash & expanding ring
    _fireball_flashes.append([cx, cy, 75, 7, 7])
    _fireball_shockwaves.append([cx, cy, 15, 110, 16, 16, (0, 220, 255)])

    # Radial flame particle splash
    for _ in range(30):
        angle = random.uniform(0, 2 * math.pi)
        speed = random.uniform(5.0, 14.0)
        evx = math.cos(angle) * speed
        evy = math.sin(angle) * speed
        life = random.randint(12, 26)
        size = random.randint(3, 7)
        color = (0, random.randint(160, 255), 255)
        _fireball_embers.append([float(cx), float(cy), evx, evy, size, life, life, color])


def draw_fireball(frame, center, size=35, angle=0, charge=1.0, is_ready=False, is_projectile=False, velocity=(0, 0)):
    """
    Renders a cinematic, multi-layered AR Fireball effect with dynamic flame turbulence,
    hand charging glow, motion blur flight trails, and explosive impact VFX.

    Parameters:
        frame: OpenCV image frame.
        center: Tuple (x, y) coordinates of fireball center.
        size: Base size/radius of fireball core.
        angle: Animation angle/timestamp for rotation.
        charge: Charge progression factor (0.0 to 1.0).
        is_ready: Boolean indicating if charge reached READY state.
        is_projectile: Boolean indicating if fireball is in projectile flight mode.
        velocity: Tuple (vx, vy) for directional flight trail.
    """
    global _fireball_embers, _fireball_shockwaves, _fireball_flashes

    x, y = int(center[0]), int(center[1])
    base_size = max(5, int(size))
    t = time.time()

    # ---------------------------------------------------------
    # 1. Pulsing / Breathing Animation & Flame Turbulence
    # ---------------------------------------------------------
    if is_ready:
        pulse = math.sin(t * 14.0) * 4.0 + math.cos(t * 26.0) * 2.0
        effective_size = max(10, int(base_size + pulse))
    else:
        pulse = math.sin(t * 8.0) * (2.0 * charge)
        effective_size = max(6, int(base_size + pulse))

    # ---------------------------------------------------------
    # 2. Hand Charging Glow & Heat Distortion Aura
    # ---------------------------------------------------------
    glow_mult = 2.4 if is_ready else (1.4 + 0.6 * charge)
    glow_r1 = int(effective_size * glow_mult)
    glow_r2 = int(effective_size * (glow_mult * 0.65))

    glow_alpha1 = 0.30 if is_ready else (0.15 * charge)
    glow_alpha2 = 0.45 if is_ready else (0.25 * charge)

    # Deep red/orange outer aura & bright orange core aura
    _draw_roi_glow(frame, (x, y), glow_r1, (0, 45, 255), glow_alpha1)
    _draw_roi_glow(frame, (x, y), glow_r2, (0, 140, 255), glow_alpha2)

    # ---------------------------------------------------------
    # 3. Directional Motion Blur & Flight Tail (Projectile Mode)
    # ---------------------------------------------------------
    if is_projectile:
        vx, vy = velocity
        speed = math.hypot(vx, vy)
        if speed > 2.0:
            tail_len = min(60, int(speed * 2.5))
            tx = int(x - (vx / speed) * tail_len)
            ty = int(y - (vy / speed) * tail_len)

            # Fading motion streak line
            cv2.line(frame, (x, y), (tx, ty), (0, 100, 255), 6, cv2.LINE_AA)
            cv2.line(frame, (x, y), (tx, ty), (0, 200, 255), 3, cv2.LINE_AA)
            cv2.line(frame, (x, y), (tx, ty), (255, 255, 255), 1, cv2.LINE_AA)

    # ---------------------------------------------------------
    # 4. Swirling Flame Turbulence & Rotating Flame Lobes
    # ---------------------------------------------------------
    num_lobes = 12 if is_ready else 8
    rot_base = angle * 2.5 if angle != 0 else (t * 220.0)

    for i in range(num_lobes):
        lobe_angle = math.radians(rot_base + i * (360.0 / num_lobes))
        # Dynamic turbulent flickering
        dist = effective_size * (1.1 + 0.3 * math.sin(t * 18.0 + i * 1.5))
        lx = int(x + dist * math.cos(lobe_angle))
        ly = int(y + dist * math.sin(lobe_angle))
        lsize = max(2, int(effective_size * 0.3 + random.randint(-1, 2)))

        # Outer flame lobes (Vivid Orange to Red gradient)
        cv2.circle(frame, (lx, ly), lsize, (0, random.randint(110, 220), 255), -1, cv2.LINE_AA)

    # ---------------------------------------------------------
    # 5. Multi-Layered Fireball Core
    # ---------------------------------------------------------
    # Layer 1: Outer flame rim (Deep Red-Orange)
    cv2.circle(frame, (x, y), effective_size, (0, 65, 255), -1, cv2.LINE_AA)

    # Layer 2: Mid flame body (Vivid Orange)
    mid_r = int(effective_size * 0.72)
    if mid_r > 0:
        cv2.circle(frame, (x, y), mid_r, (0, 150, 255), -1, cv2.LINE_AA)

    # Layer 3: Inner flame core (Bright Yellow-Orange)
    inner_r = int(effective_size * 0.45)
    if inner_r > 0:
        cv2.circle(frame, (x, y), inner_r, (0, 220, 255), -1, cv2.LINE_AA)

    # Layer 4: Hot Center Nucleus (Intense White/Yellow Core)
    hot_r = int(effective_size * 0.24)
    if hot_r > 0:
        core_color = (255, 255, 255) if (is_ready or charge > 0.7) else (190, 245, 255)
        cv2.circle(frame, (x, y), hot_r, core_color, -1, cv2.LINE_AA)

    # ---------------------------------------------------------
    # 6. Ready State Electric Arcs & Solar Flares
    # ---------------------------------------------------------
    if is_ready:
        for _ in range(4):
            arc_angle = random.uniform(0, 2 * math.pi)
            r1 = effective_size * random.uniform(0.8, 1.1)
            r2 = effective_size * random.uniform(1.3, 1.8)
            x1 = int(x + r1 * math.cos(arc_angle))
            y1 = int(y + r1 * math.sin(arc_angle))
            x2 = int(x + r2 * math.cos(arc_angle + random.uniform(-0.35, 0.35)))
            y2 = int(y + r2 * math.sin(arc_angle + random.uniform(-0.35, 0.35)))
            cv2.line(frame, (x1, y1), (x2, y2), (200, 255, 255), 1, cv2.LINE_AA)

    # ---------------------------------------------------------
    # 7. Particle Emission (Embers, Smoke & Trailing Wake)
    # ---------------------------------------------------------
    if is_projectile:
        vx, vy = velocity
        for _ in range(3):
            evx = -vx * random.uniform(0.25, 0.65) + random.uniform(-1.2, 1.2)
            evy = -vy * random.uniform(0.25, 0.65) + random.uniform(-1.2, 1.2)
            life = random.randint(12, 24)
            esize = random.randint(3, 5)
            color = (0, random.randint(150, 255), 255)
            _fireball_embers.append([float(x), float(y), evx, evy, esize, life, life, color])
    else:
        spawn_rate = 4 if is_ready else (2 if random.random() < charge else 0)
        for _ in range(spawn_rate):
            ang = random.uniform(0, 2 * math.pi)
            dist = random.uniform(0, effective_size * 0.85)
            px = x + dist * math.cos(ang)
            py = y + dist * math.sin(ang)
            evx = random.uniform(-1.4, 1.4)
            evy = random.uniform(-2.5, -0.6)
            life = random.randint(14, 30)
            esize = random.randint(2, 5)
            color = (0, random.randint(130, 240), 255)
            _fireball_embers.append([px, py, evx, evy, esize, life, life, color])

    if len(_fireball_embers) > MAX_EMBERS:
        _fireball_embers = _fireball_embers[-MAX_EMBERS:]

    # ---------------------------------------------------------
    # 8. Render Flashes, Shockwaves & Embers
    # ---------------------------------------------------------
    new_flashes = []
    for flash in _fireball_flashes:
        fx, fy, fr, life, max_l = flash
        alpha = life / float(max_l)
        _draw_roi_glow(frame, (fx, fy), fr * alpha, (220, 250, 255), 0.65 * alpha)
        life -= 1
        if life > 0:
            new_flashes.append([fx, fy, fr, life, max_l])
    _fireball_flashes = new_flashes

    new_shockwaves = []
    for sw in _fireball_shockwaves:
        sx, sy, r_curr, r_max, life, max_l, color = sw
        progress = 1.0 - (life / float(max_l))
        curr_r = int(r_curr + (r_max - r_curr) * progress)
        alpha = life / float(max_l)
        _draw_roi_glow(frame, (sx, sy), curr_r, color, 0.3 * alpha)
        cv2.circle(frame, (sx, sy), curr_r, (0, int(220 * alpha), 255), max(1, int(3 * alpha)), cv2.LINE_AA)
        life -= 1
        if life > 0:
            new_shockwaves.append([sx, sy, r_curr, r_max, life, max_l, color])
    _fireball_shockwaves = new_shockwaves

    new_embers = []
    for p in _fireball_embers:
        px, py, evx, evy, esize, life, max_l, color = p
        px += evx
        py += evy
        life -= 1

        alpha = life / float(max_l)
        curr_size = max(1, int(esize * alpha))
        cv2.circle(frame, (int(px), int(py)), curr_size, color, -1, cv2.LINE_AA)

        if life > 0:
            new_embers.append([px, py, evx, evy, esize, life, max_l, color])
    _fireball_embers = new_embers

    return frame





